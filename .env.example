# Copy this file to .env and fill in your own local values.
# Never commit .env or share your real password.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=stock_market_db

# Optional: separate MySQL administrator credentials used only by init_db.py
# to create the database. Leave blank to use DB_USER / DB_PASSWORD.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Twelve Data API (https://twelvedata.com/)
TWELVE_DATA_API_KEY=YOUR_API_KEY_HERE
